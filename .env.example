# Dominio público del sitio. Controla canonical, Open Graph, metadataBase,
# sitemap.xml, robots.txt, llms.txt y los datos estructurados (JSON-LD).
# Para cambiar de dominio, basta con modificar esta variable aquí
# (y en el panel de Vercel → Settings → Environment Variables).
# Si no se define, el código usa este mismo valor como fallback.
NEXT_PUBLIC_SITE_URL=https://www.bambukyphotography.com
